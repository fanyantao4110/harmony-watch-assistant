<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/nav_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <LinearLayout
            android:id="@+id/navStore"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="11dp"
            android:paddingRight="11dp">

            <ImageView
                android:id="@+id/navStoreIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_store"
                android:tint="@color/blue"/>

            <TextView
                android:id="@+id/navStoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/tab_store"
                android:textColor="@color/blue"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDevice"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="11dp"
            android:paddingRight="11dp">

            <ImageView
                android:id="@+id/navDeviceIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_device"
                android:tint="@color/tx2"/>

            <TextView
                android:id="@+id/navDeviceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/tab_device"
                android:textColor="@color/tx2"
                android:textSize="14sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMe"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="11dp"
            android:paddingRight="11dp">

            <ImageView
                android:id="@+id/navMeIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_me"
                android:tint="@color/tx2"/>

            <TextView
                android:id="@+id/navMeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/tab_me"
                android:textColor="@color/tx2"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
